{
    "name": "speedyspec/cli-contracts",
    "version": "1.2.0",
    "description": "Value classes PHP plugins use to extend the speedyspec CLI",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SpeedySpec",
            "email": "info@speedyspec.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "SpeedySpec\\Cli\\Contracts\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
